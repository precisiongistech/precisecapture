# PreciseCapture – environment variables (copy to .env for local development)
# Never commit .env. Every deployment (our cloud or a client's server) is configured only through these.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-dev-only
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# used in /.well-known/precisecapture and QR enrolment
PUBLIC_BASE_URL=http://localhost:8000
INSTANCE_NAME=PreciseCapture (dev)
INSTANCE_LOGO_URL=
# Oldest mobile app version this server accepts (advertised in /.well-known/precisecapture)
MIN_APP_VERSION=0.1.0

# --- Database (see ENGINEERING_NOTES.md §1) ---
# Host ports published by docker-compose.dev.yml. Change them if another service already uses the default.
# (Keep the DATABASE_URLs below in step with DB_PORT.)
DB_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MARTIN_PORT=3000
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# App connection: pc_app (no BYPASSRLS)
DATABASE_URL=postgis://pc_app:pc_app_dev@localhost:5432/precisecapture
# Migrations connection: pc_owner (table owner)
MIGRATION_DATABASE_URL=postgis://pc_owner:pc_owner_dev@localhost:5432/precisecapture
# Platform-admin connection: pc_platform (BYPASSRLS) – management commands only
PLATFORM_DATABASE_URL=postgis://pc_platform:pc_platform_dev@localhost:5432/precisecapture
POSTGRES_SUPERUSER_PASSWORD=postgres
PC_OWNER_PASSWORD=pc_owner_dev
PC_APP_PASSWORD=pc_app_dev
PC_PLATFORM_PASSWORD=pc_platform_dev
PC_TILES_PASSWORD=pc_tiles_dev
# Django admin for platform staff is only mounted on internal deployments
PLATFORM_ADMIN_ENABLED=false
# Keep pooled connections open for this many seconds (0 = close after each request)
DB_CONN_MAX_AGE=60

# GeoDjango native libraries: leave empty to auto-detect (Linux by name, macOS Homebrew prefix)
GDAL_LIBRARY_PATH=
GEOS_LIBRARY_PATH=

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# --- Object storage (MinIO locally, DigitalOcean Spaces in production) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=precisecapture-dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PRESIGN_EXPIRY_SECONDS=900

# --- Auth ---
JWT_SIGNING_KEY=change-me-dev-only
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
OTP_TTL_SECONDS=600
# console | <provider> (later)
SMS_BACKEND=console
# Mailpit locally
EMAIL_URL=smtp://localhost:1025

# --- Tiles (Martin is internal; Django proxies tile requests after auth) ---
MARTIN_URL=http://localhost:3000

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=INFO

# --- Web app (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_TILES_BASE_URL=http://localhost:8000/api/v1
