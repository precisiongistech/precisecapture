{
  "name": "@precisecapture/api-client",
  "version": "0.1.0",
  "description": "Typed TypeScript client for the PreciseCapture API (generated from contract/openapi.json)",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "generate": "openapi-typescript ../../contract/openapi.json -o src/schema.ts --alphabetize --root-types",
    "generate:check": "tsx scripts/check-generated.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm typecheck && pnpm generate:check",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
