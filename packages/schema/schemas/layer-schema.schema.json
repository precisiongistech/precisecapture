{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.precisecapture.app/layer-schema/v1.json",
  "title": "PreciseCapture layer attribute schema",
  "description": "A layer's attributes. The same document is the form the collector fills in, in field order. Published versions are immutable; keys are stable forever.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "fields"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "layerId": {
      "$ref": "#/$defs/layerKey",
      "description": "Key of the layer this schema belongs to (informational; the server sets it)."
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "$ref": "#/$defs/i18n"
    },
    "defaultLanguage": {
      "type": "string",
      "default": "en"
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/field"
      }
    },
    "lists": {
      "type": "object",
      "description": "Named option lists referenced as 'list:<name>'.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/option"
        }
      }
    }
  },
  "$defs": {
    "i18n": {
      "description": "A plain string or a map of language code to text.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?$"
          }
        }
      ]
    },
    "expression": {
      "type": "string",
      "minLength": 1,
      "description": "Expression in the PreciseCapture expression language (packages/schema/expressions.md)."
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "label"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "number"
          ]
        },
        "label": {
          "$ref": "#/$defs/i18n"
        },
        "filter": {
          "type": "object",
          "description": "For cascading selects: parent field key -> parent value.",
          "additionalProperties": {
            "type": [
              "string",
              "number"
            ]
          }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "type"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$"
        },
        "type": {
          "enum": [
            "text",
            "number",
            "integer",
            "decimal",
            "date",
            "time",
            "datetime",
            "select_one",
            "select_many",
            "yes_no",
            "phone",
            "email",
            "photo",
            "audio",
            "video",
            "file",
            "signature",
            "barcode",
            "calculate",
            "note",
            "repeat",
            "group",
            "geopoint",
            "relation"
          ]
        },
        "label": {
          "$ref": "#/$defs/i18n"
        },
        "hint": {
          "$ref": "#/$defs/i18n"
        },
        "required": {
          "description": "true/false, or an expression evaluated at capture time.",
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/expression"
            }
          ]
        },
        "relevant": {
          "$ref": "#/$defs/expression"
        },
        "constraint": {
          "$ref": "#/$defs/expression"
        },
        "constraintMessage": {
          "$ref": "#/$defs/i18n"
        },
        "expression": {
          "$ref": "#/$defs/expression"
        },
        "readonly": {
          "type": "boolean"
        },
        "default": {},
        "sticky": {
          "type": "boolean",
          "description": "Carry the last entered value into the next record."
        },
        "options": {
          "description": "'list:<name>' or an inline array.",
          "oneOf": [
            {
              "type": "string",
              "pattern": "^list:[a-z][a-z0-9_]*$"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/option"
              },
              "minItems": 1
            }
          ]
        },
        "choiceFilterParent": {
          "type": "string",
          "description": "For cascading selects: the parent field key whose value filters the options."
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "minLength": {
              "type": "integer",
              "minimum": 0
            },
            "maxLength": {
              "type": "integer",
              "minimum": 1
            },
            "pattern": {
              "type": "string"
            }
          }
        },
        "min": {
          "type": "integer",
          "minimum": 0,
          "description": "Minimum count for photo/file/repeat."
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum count for photo/file/repeat."
        },
        "maxDimensionPx": {
          "type": "integer",
          "minimum": 320,
          "maximum": 8000
        },
        "stamp": {
          "type": "boolean",
          "description": "Stamp photos with GPS position and time."
        },
        "relation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "layer"
          ],
          "properties": {
            "layer": {
              "type": "string",
              "description": "Layer key (project-unique slug) of the target layer in the same project. API paths and sync payloads use layer UUIDs; schemas reference layers by key so templates and project copies keep working.",
              "pattern": "^[a-z][a-z0-9_]{0,62}$"
            },
            "displayField": {
              "type": "string"
            },
            "allowCreateInline": {
              "type": "boolean"
            }
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          },
          "minItems": 1
        },
        "unique": {
          "type": "boolean",
          "description": "Value must be unique within the layer (checked on sync)."
        },
        "personalData": {
          "type": "boolean",
          "description": "Marks personal data for retention, export masking and field-level permissions."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "select_one",
                  "select_many"
                ]
              }
            }
          },
          "then": {
            "required": [
              "options"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "calculate"
              }
            }
          },
          "then": {
            "required": [
              "expression"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "relation"
              }
            }
          },
          "then": {
            "required": [
              "relation"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "repeat",
                  "group"
                ]
              }
            }
          },
          "then": {
            "required": [
              "fields"
            ]
          }
        }
      ]
    },
    "layerKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,62}$",
      "description": "A layer's project-unique key (slug)."
    }
  }
}
