{
  "name": "@precisecapture/schema",
  "version": "0.2.0",
  "description": "PreciseCapture shared contract: layer schemas, capture profiles, sync wire formats, expression language, capture profile resolution",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schemas/*": "./schemas/*",
    "./examples/*": "./examples/*",
    "./test-vectors/*": "./test-vectors/*"
  },
  "files": ["dist", "schemas", "examples", "test-vectors", "expressions.md", "CHANGELOG.md"],
  "scripts": {
    "build": "tsup",
    "generate": "tsx scripts/generate-types.ts",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm typecheck && tsx scripts/generate-types.ts --check",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "json-schema-to-typescript": "^15.0.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
