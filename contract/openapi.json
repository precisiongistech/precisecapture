  "components": {
    "schemas": {
      "HealthOut": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          },
          "checks": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Checks",
            "type": "object"
          }
        },
        "required": [
          "status",
          "version",
          "checks"
        ],
        "title": "HealthOut",
        "type": "object"
      },
      "WellKnownOut": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "logo_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Logo Url"
          },
          "api_version": {
            "title": "Api Version",
            "type": "string"
          },
          "min_app_version": {
            "title": "Min App Version",
            "type": "string"
          },
          "auth_methods": {
            "items": {
              "type": "string"
            },
            "title": "Auth Methods",
            "type": "array"
          },
          "api_base_url": {
            "title": "Api Base Url",
            "type": "string"
          }
        },
        "required": [
          "name",
          "logo_url",
          "api_version",
          "min_app_version",
          "auth_methods",
          "api_base_url"
        ],
        "title": "WellKnownOut",
        "type": "object"
      },
      "TokenPairOut": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          },
          "token_type": {
            "default": "Bearer",
            "title": "Token Type",
            "type": "string"
          },
          "expires_in": {
            "description": "Access token lifetime in seconds",
            "title": "Expires In",
            "type": "integer"
          }
        },
        "required": [
          "access_token",
          "refresh_token",
          "expires_in"
        ],
        "title": "TokenPairOut",
        "type": "object"
      },
      "LoginIn": {
        "properties": {
          "identifier": {
            "description": "Email address or E.164 phone number",
            "examples": [
              "ama@example.org"
            ],
            "title": "Identifier",
            "type": "string"
          },
          "password": {
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "device_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "A device registered with POST /devices",
            "title": "Device Id"
          }
        },
        "required": [
          "identifier",
          "password"
        ],
        "title": "LoginIn",
        "type": "object"
      },
      "RefreshIn": {
        "properties": {
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ],
        "title": "RefreshIn",
        "type": "object"
      },
      "LogoutIn": {
        "properties": {
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ],
        "title": "LogoutIn",
        "type": "object"
      },
      "OtpRequestOut": {
        "properties": {
          "detail": {
            "default": "If an account exists for this destination, a code has been sent.",
            "title": "Detail",
            "type": "string"
          },
          "expires_in": {
            "description": "Code lifetime in seconds",
            "title": "Expires In",
            "type": "integer"
          }
        },
        "required": [
          "expires_in"
        ],
        "title": "OtpRequestOut",
        "type": "object"
      },
      "OtpRequestIn": {
        "properties": {
          "destination": {
            "description": "Email address or E.164 phone number",
            "title": "Destination",
            "type": "string"
          }
        },
        "required": [
          "destination"
        ],
        "title": "OtpRequestIn",
        "type": "object"
      },
      "OtpVerifyIn": {
        "properties": {
          "destination": {
            "title": "Destination",
            "type": "string"
          },
          "code": {
            "maxLength": 8,
            "minLength": 4,
            "title": "Code",
            "type": "string"
          },
          "device_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Id"
          }
        },
        "required": [
          "destination",
          "code"
        ],
        "title": "OtpVerifyIn",
        "type": "object"
      },
      "MeOut": {
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserOut"
          },
          "memberships": {
            "items": {
